# NordicCart connection settings template.
# Copy this file to config/.env and fill in real values. config/.env is ignored by git.
# The variable names are the standard libpq names, so psql and Python (psycopg) read them directly.

PGHOST=localhost
PGPORT=5432
PGDATABASE=nordiccart_oltp
PGUSER=postgres
PGPASSWORD=change_me
