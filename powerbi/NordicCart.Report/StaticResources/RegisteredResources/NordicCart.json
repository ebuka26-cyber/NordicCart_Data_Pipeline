{
  "name": "NordicCart",
  "dataColors": [
    "#1F5F8B",
    "#2A9D8F",
    "#E9A23B",
    "#C44E52",
    "#6C5B7B",
    "#8AA1B1",
    "#55A868",
    "#F28E2B"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2A37",
  "tableAccent": "#1F5F8B",
  "good": "#2A9D8F",
  "neutral": "#E9A23B",
  "bad": "#C44E52",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#13304A"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 22,
      "color": "#13304A"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 9,
      "color": "#5B6B7B"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F3F5F8"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#DDE3EA"
              }
            },
            "radius": 8
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 10,
            "right": 10
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    }
  }
}
