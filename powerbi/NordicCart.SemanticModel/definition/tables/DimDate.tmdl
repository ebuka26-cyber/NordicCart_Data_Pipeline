table DimDate
	dataCategory: Time
	lineageTag: f19eeb29-003e-53ed-bcc2-c543af833088

	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		lineageTag: 06fc7c6b-531d-5304-b3fa-91194b82791a
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

	column Year
		dataType: int64
		formatString: 0
		lineageTag: 34259593-3644-5c36-9f0a-3f500211c65c
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

		annotation SummarizationSetBy = Automatic

	column Quarter
		dataType: string
		lineageTag: b7695566-93b6-5888-aff9-edd39d44b8a3
		summarizeBy: none
		isNameInferred
		sourceColumn: [Quarter]

		annotation SummarizationSetBy = Automatic

	column 'Month Number'
		dataType: int64
		formatString: #,0
		isHidden
		lineageTag: 47aa3e16-26da-53e1-bf82-101084860bd5
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Number]

		annotation SummarizationSetBy = Automatic

	column Month
		dataType: string
		lineageTag: b093778d-be64-593c-aa38-57d95d5c87da
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month]
		sortByColumn: 'Month Number'

		annotation SummarizationSetBy = Automatic

	column 'Year Month'
		dataType: string
		lineageTag: 751a9638-43dd-5e49-815a-58da1790896b
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year Month]
		sortByColumn: 'Year Month Key'

		annotation SummarizationSetBy = Automatic

	column 'Year Month Key'
		dataType: int64
		formatString: #,0
		isHidden
		lineageTag: fe81582f-d13a-59fc-9241-5c700ec163f9
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year Month Key]

		annotation SummarizationSetBy = Automatic

	column 'Month Start'
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: edf62e9a-e8f2-537c-9035-59473ea5ee16
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Start]

		annotation SummarizationSetBy = Automatic

	partition DimDate = calculated
		mode: import
		source =
			VAR _first = MIN ( MIN ( FactSales[fulfilment_date_local] ), MIN ( FactOrdersMonthly[month_start] ) )
			VAR _last = MAX ( MAX ( FactSales[fulfilment_date_local] ), MAX ( FactOrdersMonthly[month_start] ) )
			RETURN
			    ADDCOLUMNS (
			        CALENDAR ( DATE ( YEAR ( _first ), 1, 1 ), DATE ( YEAR ( _last ), 12, 31 ) ),
			        "Year", YEAR ( [Date] ),
			        "Quarter", "Q" & QUARTER ( [Date] ),
			        "Month Number", MONTH ( [Date] ),
			        "Month", FORMAT ( [Date], "mmm" ),
			        "Year Month", FORMAT ( [Date], "yyyy-mm" ),
			        "Year Month Key", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
			        "Month Start", DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 )
			    )

	annotation PBI_ResultType = Table
